# Database
DB_HOST=timescaledb
DB_NAME=stockdw
DB_USER=data226
DB_PASSWORD=changeme
DB_PORT=5432

# PostgreSQL container
POSTGRES_USER=data226
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stockdw

# Airflow
AIRFLOW__WEBSERVER__SECRET_KEY=changeme
AIRFLOW__CORE__FERNET_KEY=changeme

# Airflow web UI admin account. Was hardcoded to admin/admin in the compose
# command, on a port published to 0.0.0.0.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow's own metadata database, kept out of the warehouse so stockdw holds
# only the star schema.
AIRFLOW_DB_NAME=airflow
# Host uid that owns the repo, so Airflow can write bind-mounted files. `id -u`
AIRFLOW_UID=50000

# Kafka
KAFKA_BOOTSTRAP=stock-data-platform-kafka:9092
KAFKA_TOPIC=stock-data
STOCK_TICKERS=AAPL,AMZN,DIS,GOOG,JPM,META,MSFT,NFLX,NVDA,TSLA
# Ticker list read by the populate scripts and the ETL DAG factory
TICKERS_FILE=/opt/airflow/dags/tickers.txt

# FRED (free API key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=changeme

# SEC EDGAR (required identity for API access)
EDGAR_IDENTITY=YourName your_email@example.com
