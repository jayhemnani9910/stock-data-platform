FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY scripts/db_utils.py scripts/
ARG SCRIPT
COPY ${SCRIPT} .
ENV SCRIPT=${SCRIPT}
ENV PYTHONUNBUFFERED=1
# exec, so python replaces the shell and becomes PID 1. Without it PID 1 is
# /bin/sh, which does not forward SIGTERM, so `docker stop` never reached the
# consumer's shutdown handler -- the finally: block that flushes the buffered
# batch and commits offsets -- and up to 50 ticks were lost on every clean stop.
CMD exec python ${SCRIPT}
